PORT=4000
DATABASE_URL=postgres://garment_erp:garment_erp@localhost:5432/garment_erp

# Comma-separated list of origins allowed to send credentialed requests
# (the Next.js dev server by default).
APP_ORIGIN=http://localhost:3000

# Session cookie lifetime, in hours.
SESSION_TTL_HOURS=168

# Only used by `pnpm db:seed`, and only to create a bootstrap admin user on
# first run — leave unset after that. Never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
